# Never commit real values. Set these in the runtime environment.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=moonshotai/kimi-k3
NVIDIA_TEMPERATURE=0.0

# Live quality gate: serial only, no load test.
LIVE_LEGALBENCH_CASES=3
LIVE_LEGALBENCH_INTERVAL_SECONDS=30
LIVE_LEGALBENCH_MAX_TOKENS=256
NVIDIA_RPM_LIMIT=2
NVIDIA_RETRIES=0
LEGALBENCH_LIVE_CONFIRM=false
